{
  "version": 1,
  "purpose": "Normalized public community, forum, Q&A, news, and social metadata content.",
  "privacy_rule": "Public content only; do not include private, authentication-protected, or access-controlled material.",
  "fields": [
    {"name": "content_id", "type": "string", "required": true},
    {"name": "source_key", "type": "string", "required": true},
    {"name": "source_name", "type": "string", "required": true},
    {"name": "source_type", "type": "string", "required": true},
    {"name": "platform", "type": "string", "required": true},
    {"name": "content_type", "type": "string", "allowed": ["forum_posts", "questions_answers", "discussions", "comments", "public_social_posts", "public_video_comments", "articles", "community_discussions", "housing_program_questions", "real_estate_investment_discussions"]},
    {"name": "title", "type": "string"},
    {"name": "content", "type": "string"},
    {"name": "author_display_name", "type": "string"},
    {"name": "published_at", "type": "datetime"},
    {"name": "source_url", "type": "string"},
    {"name": "parent_url", "type": "string"},
    {"name": "discussion_id", "type": "string"},
    {"name": "comment_id", "type": "string"},
    {"name": "engagement_metrics", "type": "object"},
    {"name": "state", "type": "string"},
    {"name": "municipality", "type": "string"},
    {"name": "neighborhood", "type": "string"},
    {"name": "property_type", "type": "string"},
    {"name": "asking_price", "type": "float"},
    {"name": "rent_price", "type": "float"},
    {"name": "bedrooms", "type": "integer"},
    {"name": "bathrooms", "type": "integer"},
    {"name": "square_meters", "type": "float"},
    {"name": "transaction_context", "type": "string"},
    {"name": "housing_program_references", "type": "array"},
    {"name": "financing_references", "type": "array"},
    {"name": "relevant_entities", "type": "array"},
    {"name": "extracted_keywords", "type": "array"},
    {"name": "language", "type": "string", "default": "es"},
    {"name": "sentiment", "type": "string", "note": "Only populate when an existing permitted adapter already supports it."},
    {"name": "crawl_timestamp", "type": "datetime", "required": true},
    {"name": "legal_status", "type": "string", "default": "manual_review"}
  ]
}
